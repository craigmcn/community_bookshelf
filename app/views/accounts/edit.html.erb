<% content_for :title, "My Account" %>

<div class="row justify-content-center">
  <div class="col-md-7">
    <h1 class="mb-4">My Account</h1>

    <% unless @user.email_confirmed? %>
      <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <span><i class="fasl fa-triangle-exclamation me-2"></i>Your email address isn't confirmed yet.</span>
        <%= button_to "Resend confirmation email", email_confirmation_path, method: :post, class: "btn btn-sm btn-outline-dark" %>
      </div>
    <% end %>

    <%= form_with model: @user, url: account_path, method: :patch, multipart: true, class: "needs-validation" do |form| %>
      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <strong><%= pluralize(@user.errors.count, "error") %> prevented your profile from being saved:</strong>
          <ul class="mb-0 mt-1">
            <% @user.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= form.label :email, class: "form-label" %>
        <input type="email" class="form-control" value="<%= @user.email %>" disabled>
        <div class="form-text">Contact an admin to change your email address.</div>
      </div>

      <div class="mb-3">
        <%= form.label :name, "Display Name", class: "form-label" %>
        <%= form.text_field :name, class: "form-control", placeholder: "Shown instead of your email on books and reviews you contribute" %>
      </div>

      <div class="mb-3">
        <%= form.label :bio, class: "form-label" %>
        <%= form.text_area :bio, class: "form-control", rows: 4, placeholder: "A short bio for other members to see" %>
      </div>

      <div class="mb-3">
        <%= form.label :favorite_genre_list, "Favorite Genres", class: "form-label" %>
        <%= form.text_field :favorite_genre_list, class: "form-control", placeholder: "fantasy, sci-fi, ..." %>
        <div class="form-text">Comma-separated. Shown on your public profile.</div>
      </div>

      <div class="mb-3">
        <%= form.label :avatar, "Avatar", class: "form-label d-block" %>
        <% if @user.avatar.attached? %>
          <div class="d-flex align-items-center gap-3 mb-2">
            <%= image_tag @user.avatar, style: "width: 80px; height: 80px; object-fit: cover; border-radius: 50%;", alt: "Current avatar" %>
            <div class="form-check">
              <%= check_box_tag :remove_avatar, "1", false, class: "form-check-input" %>
              <%= label_tag :remove_avatar, "Remove avatar", class: "form-check-label" %>
            </div>
          </div>
        <% end %>
        <%= form.file_field :avatar, class: "form-control", accept: "image/png,image/jpeg,image/webp" %>
        <div class="form-text">PNG, JPEG, or WEBP, up to 5MB.</div>
      </div>

      <div class="d-flex gap-2">
        <%= form.submit "Save Changes", class: "btn btn-primary" %>
      </div>
    <% end %>

    <hr class="my-5">

    <div class="card mb-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="card-title mb-0"><i class="fasl fa-trophy me-2 opacity-75"></i>Reading Challenges</h5>
          <%= link_to "Manage", reading_challenges_path, class: "btn btn-sm btn-outline-secondary" %>
        </div>
        <% if (challenge = @user.current_year_challenge) %>
          <p class="text-muted small mb-1"><%= challenge.year %>: <%= challenge.books_finished_count %> of <%= challenge.goal %> books finished</p>
          <div class="progress" role="progressbar" aria-valuenow="<%= challenge.progress_percent %>" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar<%= " bg-success" if challenge.completed? %>" style="width: <%= challenge.progress_percent %>%">
              <%= challenge.progress_percent %>%
            </div>
          </div>
        <% else %>
          <p class="text-muted mb-0">You haven't set a reading challenge for <%= Date.current.year %> yet.</p>
        <% end %>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title mb-3"><i class="fasl fa-fire me-2 opacity-75"></i>Reading Streak</h5>
        <p class="mb-0">
          <span class="fs-4 fw-bold"><%= @user.current_streak %></span>
          <span class="text-muted"><%= (@user.current_streak == 1) ? "book" : "books" %> in a row</span>
        </p>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title mb-3"><i class="fasl fa-medal me-2 opacity-75"></i>Badges</h5>
        <% if @user.badges.any? %>
          <div class="d-flex flex-wrap gap-2">
            <% @user.badges.each do |badge| %>
              <span class="badge text-bg-primary" title="<%= badge.description %>"><%= badge.name %></span>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted mb-0">No badges earned yet — finish a book, write a review, or set a reading challenge to start earning them.</p>
        <% end %>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="card-title mb-0"><i class="fasl fa-key me-2 opacity-75"></i>API Access</h5>
          <%= link_to "Manage", api_tokens_path, class: "btn btn-sm btn-outline-secondary" %>
        </div>
        <% if @user.api_tokens.any? %>
          <p class="text-muted small mb-0"><%= pluralize(@user.api_tokens.count, "active API token") %></p>
        <% else %>
          <p class="text-muted mb-0">No API tokens yet.</p>
        <% end %>
      </div>
    </div>

    <div class="card border-danger">
      <div class="card-header bg-danger text-white">Danger Zone</div>
      <div class="card-body">
        <h5 class="card-title">Delete Account</h5>
        <p class="card-text text-muted">
          This permanently deletes your account, your readings, reviews, and lists. Books you added
          to the catalog stay, attributed to a "Deleted user" account. This can't be undone.
        </p>
        <%= form_with url: account_path, method: :delete do |form| %>
          <div class="mb-3">
            <%= form.label :current_password, "Confirm your password to continue", class: "form-label" %>
            <%= form.password_field :current_password, class: "form-control", required: true %>
          </div>
          <%= form.submit "Delete my account", class: "btn btn-danger",
                data: { turbo_confirm: "This is permanent. Delete your account?" } %>
        <% end %>
      </div>
    </div>
  </div>
</div>
