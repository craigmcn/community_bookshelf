<% content_for :title, @book.title %>

<div class="row">
  <div class="col-md-3">
    <% if @book.cover_url.present? %>
      <%= image_tag @book.cover_url, class: "img-fluid rounded shadow-sm", alt: @book.title %>
    <% else %>
      <div class="book-placeholder book-placeholder-lg d-flex align-items-center justify-content-center" style="height: 300px;">
        <i class="fasl fa-book-open-cover fa-4x text-white opacity-50"></i>
      </div>
    <% end %>
  </div>

  <div class="col-md-9">
    <h1><%= @book.title %></h1>
    <p class="fs-5 text-muted"><%= @book.author %></p>
    <p class="text-muted"><small>Added by <%= @book.added_by.email %></small></p>

    <% if @book.series.present? %>
      <p>
        <%= link_to @book.series.name, @book.series, class: "text-decoration-none" %>
        <% if @book.series_position.present? %>
          <span class="text-muted">— Book <%= @book.series_position %></span>
        <% end %>
      </p>
    <% end %>

    <ul class="list-unstyled text-muted small mb-0">
      <% if @book.isbn.present? %>
        <li>ISBN: <%= @book.isbn %></li>
      <% end %>
      <% if @book.page_count.present? %>
        <li><%= pluralize(@book.page_count, "page") %></li>
      <% end %>
      <% if @book.published_on.present? %>
        <li>Published <%= @book.published_on.strftime("%B %-d, %Y") %></li>
      <% end %>
    </ul>

    <div class="d-flex flex-wrap gap-2 mt-4">
      <%= link_to books_path, class: "btn btn-outline-secondary" do %>
        <i class="fasl fa-arrow-left me-1"></i>Back to Books
      <% end %>
      <% if current_user %>
        <%= link_to new_reading_path(book_id: @book.id), class: "btn btn-primary" do %>
          <i class="fasl fa-bookmark-plus me-1"></i><%= @user_readings.any? ? "Log a Re-read" : "Add to Shelf" %>
        <% end %>
      <% end %>
      <% if current_user %>
        <div class="dropdown">
          <button class="btn btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="fasl fa-list-ul me-1"></i>Save to a List
          </button>
          <ul class="dropdown-menu">
            <% if @user_shelves.present? %>
              <% @user_shelves.each do |shelf| %>
                <li>
                  <% if @shelf_ids_with_book.include?(shelf.id) %>
                    <span class="dropdown-item-text text-muted">
                      <i class="fasl fa-check me-1"></i><%= shelf.name %>
                    </span>
                  <% else %>
                    <%= button_to shelf_shelf_books_path(shelf, book_id: @book.id),
                          method: :post, class: "dropdown-item" do %>
                      <%= shelf.name %>
                    <% end %>
                  <% end %>
                </li>
              <% end %>
              <li><hr class="dropdown-divider"></li>
            <% end %>
            <li>
              <%= link_to new_shelf_path, class: "dropdown-item" do %>
                <i class="fasl fa-plus me-1"></i>New List
              <% end %>
            </li>
          </ul>
        </div>
      <% end %>
      <% if policy(@book).update? %>
        <%= link_to edit_book_path(@book), class: "btn btn-outline-primary" do %>
          <i class="fasl fa-pen-to-square me-1"></i>Edit
        <% end %>
      <% end %>
      <% if policy(@book).destroy? %>
        <%= button_to @book, method: :delete,
              class: "btn btn-outline-danger",
              form: { data: { turbo_confirm: "Delete #{@book.title}?" } } do %>
          <i class="fasl fa-trash-can me-1"></i>Delete
        <% end %>
      <% end %>
    </div>

    <% if @book.description.present? %>
      <p class="mt-4"><%= @book.description %></p>
    <% end %>

    <% if @book.subjects.any? %>
      <div class="d-flex flex-wrap gap-1 mt-2">
        <% @book.subjects.each do |subject| %>
          <span class="badge text-bg-secondary"><%= subject %></span>
        <% end %>
      </div>
    <% end %>

    <% {genre: "text-bg-primary", mood: "text-bg-info", pace: "text-bg-warning"}.each do |category, badge_class| %>
      <% category_tags = @book.tags.select { |tag| tag.category == category.to_s }.sort_by(&:name) %>
      <% if category_tags.any? %>
        <div class="d-flex flex-wrap align-items-center gap-1 mt-2">
          <span class="text-muted small me-1"><%= category.to_s.capitalize %>:</span>
          <% category_tags.each do |tag| %>
            <%= link_to tag.name, books_path(tag: tag.name), class: ["badge text-decoration-none", badge_class] %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<% if @similar_books.any? %>
  <hr class="my-4">
  <h3><i class="fasl fa-shapes me-2 opacity-75"></i>Similar Books</h3>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    <% @similar_books.each do |book| %>
      <div class="col">
        <%= link_to book, class: "text-decoration-none text-dark", data: { turbo_prefetch: false } do %>
          <%= render book %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<% if @user_readings.any? %>
  <hr class="my-4">
  <h3><i class="fasl fa-bookmark me-2 opacity-75"></i>Your Readings of This Book</h3>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead>
        <tr>
          <th>Status</th>
          <th>Rating</th>
          <th>Review</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @user_readings.each do |reading| %>
          <tr>
            <td>
              <span class="badge badge-status-<%= reading.status.tr('_', '-') %>">
                <%= reading.status_label %>
              </span>
            </td>
            <td>
              <% if reading.rating %>
                <span class="visually-hidden"><%= reading.rating.humanize %></span>
                <% Reading.ratings[reading.rating].times do %>
                  <i class="fasl fa-star text-warning" aria-hidden="true"></i>
                <% end %>
              <% else %>
                —
              <% end %>
            </td>
            <td><%= truncate(reading.review, length: 100) %></td>
            <td>
              <%= link_to reading, class: "btn btn-sm btn-outline-success" do %>
                <i class="fasl fa-eye" aria-hidden="true"></i>
                <span class="visually-hidden">View reading</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% if @book.readings.any? %>
  <hr class="my-4">
  <h3><i class="fasl fa-users me-2 opacity-75"></i>Community Readings</h3>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead>
        <tr>
          <th>Reader</th>
          <th>Status</th>
          <th>Rating</th>
          <th>Format</th>
          <th>Review</th>
        </tr>
      </thead>
      <tbody>
        <% @book.readings.includes(:user).each do |reading| %>
          <tr>
            <td><%= reading.user.email %></td>
            <td>
              <span class="badge badge-status-<%= reading.status.tr('_', '-') %>">
                <%= reading.status_label %>
              </span>
              <% if reading.progress_percent.present? %>
                <span class="text-muted small">(<%= reading.progress_percent %>%)</span>
              <% end %>
            </td>
            <td>
              <% if reading.rating %>
                <span class="visually-hidden"><%= reading.rating.humanize %></span>
                <% Reading.ratings[reading.rating].times do %>
                  <i class="fasl fa-star text-warning" aria-hidden="true"></i>
                <% end %>
              <% else %>
                —
              <% end %>
            </td>
            <td><%= reading.format.present? ? reading.format.humanize : "—" %></td>
            <td>
              <% if reading.review.blank? %>
                —
              <% elsif reading.is_review_public? || reading.user == current_user || current_user&.moderator_or_above? %>
                <%= truncate(reading.review, length: 100) %>
              <% else %>
                <span class="text-muted fst-italic">Review is private</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
