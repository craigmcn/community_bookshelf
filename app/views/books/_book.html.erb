<div class="card h-100" id="<%= dom_id book %>">
  <% if book.cover_url.present? %>
    <%= image_tag book.cover_url, class: "card-img-top", style: "object-fit: cover; height: 200px;", alt: book.title, loading: "lazy" %>
  <% else %>
    <div class="book-placeholder d-flex align-items-center justify-content-center" style="height: 200px;">
      <i class="fasl fa-book-open-cover fa-3x text-white opacity-50"></i>
    </div>
  <% end %>
  <div class="card-body">
    <h5 class="card-title"><%= book.title %></h5>
    <p class="card-text text-muted mb-1"><%= book.author %></p>
    <p class="card-text"><small class="text-muted">Added by <%= book.added_by.display_name %></small></p>
  </div>
</div>
