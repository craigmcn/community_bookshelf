<% content_for :title, "Admin Dashboard" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">Admin Dashboard</h1>
  <%= link_to "Manage Users", admin_users_path, class: "btn btn-outline-primary" %>
</div>

<div class="row g-4 mb-5">
  <div class="col-md-4">
    <div class="card text-center border-0 shadow-sm">
      <div class="card-body py-4">
        <div class="display-4 fw-bold text-primary"><%= @total_users %></div>
        <div class="text-muted mt-1">Users</div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card text-center border-0 shadow-sm">
      <div class="card-body py-4">
        <div class="display-4 fw-bold text-success"><%= @total_books %></div>
        <div class="text-muted mt-1">Books</div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card text-center border-0 shadow-sm">
      <div class="card-body py-4">
        <div class="display-4 fw-bold text-warning"><%= @total_readings %></div>
        <div class="text-muted mt-1">Readings Logged</div>
      </div>
    </div>
  </div>
</div>

<h3 class="mb-3">Most-Read Books</h3>
<% if @popular_books.any? %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th>Title</th>
          <th>Author</th>
          <th class="text-end">Readings</th>
        </tr>
      </thead>
      <tbody>
        <% @popular_books.each do |book| %>
          <tr>
            <td><%= link_to book.title, book, class: "text-decoration-none fw-semibold" %></td>
            <td class="text-muted"><%= book.author %></td>
            <td class="text-end"><span class="badge bg-secondary"><%= book.readings.size %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-muted">No readings logged yet.</p>
<% end %>
