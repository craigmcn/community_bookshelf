<% content_for :title, "Users — Admin" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">Users</h1>
  <span class="text-muted"><%= @users.count %> total</span>
</div>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-dark">
      <tr>
        <th>Email</th>
        <th>Roles</th>
        <th>Joined</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.email %></td>
          <td>
            <% badge_class = { "admin" => "bg-danger", "moderator" => "bg-warning text-dark", "member" => "bg-secondary" } %>
            <% if user.roles.any? %>
              <% user.roles.each do |role| %>
                <span class="badge <%= badge_class[role.name] %>"><%= role.name.capitalize %></span>
              <% end %>
            <% else %>
              <span class="text-muted">None</span>
            <% end %>
          </td>
          <td class="text-muted"><%= user.created_at.strftime("%b %-d, %Y") %></td>
          <td class="text-end">
            <%= link_to "Edit Roles", edit_admin_user_path(user), class: "btn btn-sm btn-outline-secondary" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
