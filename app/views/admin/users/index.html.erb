<% content_for :title, "Users — Admin" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">Users</h1>
  <span class="text-muted"><%= @users.count %> total</span>
</div>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-dark">
      <tr>
        <th>Email</th>
        <th>Role</th>
        <th>Joined</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.email %></td>
          <td>
            <% badge_class = { "admin" => "bg-danger", "moderator" => "bg-warning text-dark", "member" => "bg-secondary" }[user.role] %>
            <span class="badge <%= badge_class %>"><%= user.role.capitalize %></span>
          </td>
          <td class="text-muted"><%= user.created_at.strftime("%b %-d, %Y") %></td>
          <td class="text-end">
            <%= link_to "Edit Role", edit_admin_user_path(user), class: "btn btn-sm btn-outline-secondary" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
