<% content_for :title, "Reviewed Readings" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">Reviewed Readings</h1>
  <span class="badge bg-secondary fs-6"><%= @readings.size %> with reviews</span>
</div>

<% if @readings.any? %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th>Member</th>
          <th>Book</th>
          <th>Status</th>
          <th>Rating</th>
          <th>Review</th>
          <th>Updated</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: "admin/readings/reading", collection: @readings %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="text-center text-muted py-5">
    <p class="fs-5">No reviewed readings yet.</p>
  </div>
<% end %>
