<% content_for :title, @profile_user.display_name %>

<div class="row">
  <div class="col-md-4">
    <div class="card">
      <div class="card-body text-center">
        <% if @profile_user.avatar.attached? %>
          <%= image_tag @profile_user.avatar, style: "width: 120px; height: 120px; object-fit: cover; border-radius: 50%;", alt: "#{@profile_user.display_name}'s avatar" %>
        <% else %>
          <i class="fasl fa-circle-user fa-6x text-muted opacity-50" aria-hidden="true"></i>
        <% end %>
        <h2 class="mt-3 mb-0"><%= @profile_user.display_name %></h2>

        <% if @profile_user.bio.present? %>
          <p class="text-muted mt-3 mb-0"><%= @profile_user.bio %></p>
        <% end %>

        <% if @profile_user.favorite_genre_tags.any? %>
          <div class="d-flex flex-wrap justify-content-center gap-1 mt-3">
            <% @profile_user.favorite_genre_tags.order(:name).each do |tag| %>
              <%= link_to tag.name, books_path(tag: tag.name), class: "badge text-bg-primary text-decoration-none" %>
            <% end %>
          </div>
        <% end %>

        <div class="d-flex justify-content-center gap-4 mt-4 text-muted">
          <div>
            <div class="fs-4 fw-bold text-dark"><%= @finished_count %></div>
            <div class="small">Finished</div>
          </div>
          <div>
            <div class="fs-4 fw-bold text-dark"><%= @currently_reading_count %></div>
            <div class="small">Reading</div>
          </div>
          <div>
            <%= link_to followers_user_path(@profile_user), class: "text-decoration-none text-dark" do %>
              <div class="fs-4 fw-bold"><%= @profile_user.followers.excluding_deleted_placeholder.count %></div>
              <div class="small text-muted">Followers</div>
            <% end %>
          </div>
          <div>
            <%= link_to following_user_path(@profile_user), class: "text-decoration-none text-dark" do %>
              <div class="fs-4 fw-bold"><%= @profile_user.following.excluding_deleted_placeholder.count %></div>
              <div class="small text-muted">Following</div>
            <% end %>
          </div>
        </div>

        <% if @profile_user == current_user %>
          <%= link_to edit_account_path, class: "btn btn-outline-primary btn-sm mt-4" do %>
            <i class="fasl fa-pen-to-square me-1"></i>Edit Profile
          <% end %>
        <% elsif current_user.following?(@profile_user) %>
          <%= button_to user_follow_path(@profile_user), method: :delete, class: "btn btn-outline-secondary btn-sm mt-4" do %>
            <i class="fasl fa-user-check me-1"></i>Following
          <% end %>
        <% else %>
          <%= button_to user_follow_path(@profile_user), method: :post, class: "btn btn-primary btn-sm mt-4" do %>
            <i class="fasl fa-user-plus me-1"></i>Follow
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-8">
    <h3><i class="fasl fa-comment-lines me-2 opacity-75"></i>Public Reviews</h3>
    <% if @public_reviews.any? %>
      <% @public_reviews.each do |reading| %>
        <div class="card mb-3">
          <div class="card-body">
            <h5 class="card-title mb-1"><%= link_to reading.book.title, reading.book, class: "text-decoration-none" %></h5>
            <p class="text-muted small mb-2">
              <% if reading.rating %>
                <% Reading.ratings[reading.rating].times do %>
                  <i class="fasl fa-star text-warning" aria-hidden="true"></i>
                <% end %>
              <% end %>
            </p>
            <p class="card-text"><%= truncate(reading.review, length: 280) %></p>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-muted"><%= @profile_user.display_name %> hasn't written any public reviews yet.</p>
    <% end %>
  </div>
</div>
