<div class="card mb-3" id="<%= dom_id shelf %>">
  <div class="card-body d-flex justify-content-between align-items-center">
    <div>
      <%= link_to shelf.name, shelf, class: "card-title h5 mb-0 text-decoration-none" %>
      <div class="text-muted small"><%= pluralize(shelf.shelf_books.size, "book") %></div>
    </div>
    <div class="d-flex gap-2">
      <%= link_to edit_shelf_path(shelf), class: "btn btn-sm btn-outline-secondary" do %>
        <i class="fasl fa-pen-to-square"></i>
      <% end %>
      <%= button_to shelf, method: :delete,
            class: "btn btn-sm btn-outline-danger",
            form: { data: { turbo_confirm: "Delete \"#{shelf.name}\"?" } } do %>
        <i class="fasl fa-trash-can"></i>
      <% end %>
    </div>
  </div>
</div>
