<tr id="<%= dom_id reading %>">
  <td>
    <%= link_to reading.book.title, reading.book, class: "text-decoration-none fw-semibold", data: {turbo_frame: "_top"} %>
    <% if reading.deleted? %>
      <span class="badge bg-danger ms-1">deleted</span>
    <% end %>
  </td>
  <td>
    <%
      status_icon = case reading.status
                    when "want_to_read" then "fa-bookmark"
                    when "reading"      then "fa-book-open-reader"
                    when "finished"     then "fa-circle-check"
                    when "dnf"          then "fa-circle-xmark"
                    end
    %>
    <span class="badge badge-status-<%= reading.status.tr('_', '-') %>">
      <i class="fasl <%= status_icon %> me-1"></i><%= reading.status_label %>
    </span>
  </td>
  <td>
    <% if reading.rating %>
      <span class="visually-hidden"><%= reading.rating.humanize %></span>
      <% Reading.ratings[reading.rating].times do %>
        <i class="fasl fa-star text-warning" aria-hidden="true"></i>
      <% end %>
    <% else %>
      —
    <% end %>
  </td>
  <td>
    <% if reading.progress_percent.present? %>
      <span class="text-muted small"><%= reading.progress_percent %>%</span>
    <% else %>
      —
    <% end %>
  </td>
  <td class="text-muted"><%= truncate(reading.review, length: 80) %></td>
  <td class="d-flex">
    <% if policy(reading).edit? %>
      <%= link_to edit_reading_path(reading), class: "btn btn-sm btn-outline-secondary", data: {turbo_frame: "_top"} do %>
        <i class="fasl fa-pen-to-square"></i>
      <% end %>
    <% end %>
    <% if policy(reading).destroy? %>
      <%= button_to reading, method: :delete,
            class: "btn btn-sm btn-outline-danger ms-1",
            form: { data: { turbo_confirm: "Remove this reading?", turbo_frame: "_top" } } do %>
        <i class="fasl fa-trash-can"></i>
      <% end %>
    <% end %>
  </td>
</tr>
