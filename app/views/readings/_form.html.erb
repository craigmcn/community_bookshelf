<%= form_with(model: reading) do |form| %>
  <%= form.hidden_field :user_id, value: current_user.id %>

  <% if reading.errors.any? %>
    <div class="alert alert-danger">
      <strong><%= pluralize(reading.errors.count, "error") %> prevented this reading from being saved:</strong>
      <ul class="mb-0 mt-1">
        <% reading.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :book_id, "Book", class: "form-label" %>
    <%= form.collection_select :book_id, Book.order(:title), :id, :title,
          { prompt: "Select a book" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= form.label :status, class: "form-label" %>
    <%= form.select :status, Reading.statuses.keys.map { |s| [s.humanize, s] },
          { prompt: "Select a status" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= form.label :rating, class: "form-label" %>
    <%= form.select :rating, Reading.ratings.keys.map { |r| [r.humanize, r] },
          { include_blank: "No rating" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= form.label :review, class: "form-label" %>
    <%= form.textarea :review, class: "form-control", rows: 4, placeholder: "What did you think?" %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", readings_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
