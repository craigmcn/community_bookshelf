<% content_for :title, @reading.book.title %>

<div class="card">
  <div class="card-body">
    <div class="d-flex align-items-center gap-2 mb-1">
      <h2 class="card-title mb-0"><%= @reading.book.title %></h2>
      <% if @reading.deleted? %>
        <span class="badge bg-danger">deleted</span>
      <% end %>
    </div>
    <p class="text-muted"><%= @reading.book.author %></p>

    <dl class="row mt-3">
      <dt class="col-sm-2">Status</dt>
      <dd class="col-sm-10">
        <%
          status_icon = case @reading.status
                        when "want_to_read" then "fa-bookmark"
                        when "reading"      then "fa-book-open-reader"
                        when "finished"     then "fa-circle-check"
                        when "dnf"          then "fa-circle-xmark"
                        end
        %>
        <span class="badge badge-status-<%= @reading.status.tr('_', '-') %>">
          <i class="fasl <%= status_icon %> me-1"></i><%= @reading.status_label %>
        </span>
      </dd>

      <dt class="col-sm-2">Rating</dt>
      <dd class="col-sm-10">
        <% if @reading.rating %>
          <span class="visually-hidden"><%= @reading.rating.humanize %></span>
          <% Reading.ratings[@reading.rating].times do %>
            <i class="fasl fa-star text-warning" aria-hidden="true"></i>
          <% end %>
        <% else %>
          —
        <% end %>
      </dd>

      <% if @reading.format.present? %>
        <dt class="col-sm-2">Format</dt>
        <dd class="col-sm-10"><%= @reading.format.humanize %></dd>
      <% end %>

      <% if @reading.started_on.present? || @reading.finished_on.present? %>
        <dt class="col-sm-2">Dates</dt>
        <dd class="col-sm-10">
          <% if @reading.started_on.present? %>
            Started <%= @reading.started_on.strftime("%B %-d, %Y") %>
          <% end %>
          <% if @reading.finished_on.present? %>
            <% if @reading.started_on.present? %> — <% end %>Finished <%= @reading.finished_on.strftime("%B %-d, %Y") %>
          <% end %>
        </dd>
      <% end %>

      <% if @reading.progress_percent.present? %>
        <dt class="col-sm-2">Progress</dt>
        <dd class="col-sm-10">
          <div class="progress" style="height: 1.25rem; max-width: 20rem;" role="progressbar" aria-label="Reading progress" aria-valuenow="<%= @reading.progress_percent %>" aria-valuemin="0" aria-valuemax="100" aria-valuetext="<%= @reading.progress_percent %>%">
            <div class="progress-bar" style="width: <%= @reading.progress_percent %>%;"><%= @reading.progress_percent %>%</div>
          </div>
        </dd>
      <% end %>

      <% if @reading.review.present? %>
        <dt class="col-sm-2">Review</dt>
        <dd class="col-sm-10">
          <%= @reading.review %>

          <% if @reading.is_review_public? %>
            <div class="mt-2">
              <% if current_user && @reading.review_likes.exists?(user_id: current_user.id) %>
                <%= button_to reading_review_like_path(@reading), method: :delete, class: "btn btn-sm btn-primary" do %>
                  <i class="fasl fa-heart me-1"></i>Liked (<%= @reading.review_likes.count %>)
                <% end %>
              <% elsif policy(ReviewLike.new(reading: @reading)).create? %>
                <%= button_to reading_review_like_path(@reading), method: :post, class: "btn btn-sm btn-outline-primary" do %>
                  <i class="fasl fa-heart me-1"></i>Like (<%= @reading.review_likes.count %>)
                <% end %>
              <% elsif @reading.review_likes.any? %>
                <span class="text-muted small"><i class="fasl fa-heart me-1"></i><%= pluralize(@reading.review_likes.count, "like") %></span>
              <% end %>
            </div>
          <% end %>
        </dd>
      <% end %>
    </dl>

    <% if @reading.is_review_public? && @reading.review.present? %>
      <hr class="my-4">
      <h3><i class="fasl fa-comments me-2 opacity-75"></i>Comments</h3>

      <% if @review_comments.any? %>
        <div class="list-group mb-3">
          <% @review_comments.each do |comment| %>
            <div class="list-group-item">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <%= link_to comment.user.display_name, comment.user, class: "fw-semibold text-decoration-none" %>
                  <span class="text-muted small ms-2"><%= time_ago_in_words(comment.created_at) %> ago</span>
                </div>
                <% if policy(comment).destroy? %>
                  <%= button_to reading_review_comment_path(@reading, comment), method: :delete,
                        class: "btn btn-sm btn-link text-danger p-0",
                        form: { data: { turbo_confirm: "Delete this comment?" } } do %>
                    <i class="fasl fa-trash-can"></i>
                  <% end %>
                <% end %>
              </div>
              <p class="mb-0 mt-1"><%= comment.body %></p>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if policy(ReviewComment.new(reading: @reading)).create? %>
        <%= form_with model: ReviewComment.new, url: reading_review_comments_path(@reading) do |form| %>
          <div class="mb-2">
            <%= form.text_area :body, class: "form-control", rows: 2, placeholder: "Add a comment..." %>
          </div>
          <%= form.submit "Post Comment", class: "btn btn-outline-primary btn-sm" %>
        <% end %>
      <% end %>
    <% end %>

    <div class="d-flex gap-2 mt-3">
      <% if current_user&.moderator_or_above? %>
        <%= link_to admin_readings_path, class: "btn btn-outline-secondary" do %>
          <i class="fasl fa-arrow-left me-1"></i>Back to Reviewed Readings
        <% end %>
      <% else %>
        <%= link_to readings_path, class: "btn btn-outline-secondary" do %>
          <i class="fasl fa-arrow-left me-1"></i>Back to Shelf
        <% end %>
      <% end %>
      <% if policy(@reading).edit? %>
        <%= link_to edit_reading_path(@reading), class: "btn btn-outline-primary" do %>
          <i class="fasl fa-pen-to-square me-1"></i>Edit
        <% end %>
      <% end %>
      <% if policy(@reading).destroy? %>
        <%= button_to @reading, method: :delete,
              class: "btn btn-outline-danger",
              form: { data: { turbo_confirm: "Remove this reading?" } } do %>
          <i class="fasl fa-trash-can me-1"></i>Delete
        <% end %>
      <% end %>
    </div>
  </div>
</div>
