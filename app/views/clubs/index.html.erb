<% content_for :title, "Book Clubs" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0"><i class="fasl fa-people-group me-2 opacity-75"></i>Book Clubs</h1>
  <%= link_to new_club_path, class: "btn btn-primary" do %>
    <i class="fasl fa-plus me-1"></i>Start a Club
  <% end %>
</div>

<% if @clubs.any? %>
  <div class="row row-cols-1 row-cols-md-2 g-4">
    <% @clubs.each do |club| %>
      <div class="col">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title"><%= link_to club.name, club, class: "text-decoration-none" %></h5>
            <p class="text-muted small mb-2">Reading <%= club.book.title %></p>
            <p class="card-text"><%= truncate(club.description, length: 140) %></p>
            <p class="text-muted small mb-0"><%= pluralize(club.members.count, "member") %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">No book clubs yet. Start one around a book you want to discuss.</p>
<% end %>
