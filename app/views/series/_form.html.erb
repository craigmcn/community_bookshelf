<%= form_with(model: series) do |form| %>
  <% if series.errors.any? %>
    <div class="alert alert-danger">
      <strong><%= pluralize(series.errors.count, "error") %> prevented this series from being saved:</strong>
      <ul class="mb-0 mt-1">
        <% series.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", series_index_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
