<turbo-frame id="book-search-results">
  <% if @results.nil? %>
  <% elsif @results.empty? %>
    <p class="text-muted small mt-2 mb-0">No results found.</p>
  <% else %>
    <div class="list-group mt-2">
      <% @results.each do |result| %>
        <button type="button"
                class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2"
                data-action="book-search#selectBook"
                data-book-search-title-param="<%= result[:title] %>"
                data-book-search-author-param="<%= result[:author] %>"
                data-book-search-cover-url-param="<%= result[:cover_url] %>"
                data-book-search-open-library-key-param="<%= result[:open_library_key] %>">
          <% if result[:cover_url] %>
            <img src="<%= result[:cover_url] %>" style="height:50px; width:35px; object-fit:cover; flex-shrink:0;" alt="">
          <% else %>
            <div style="height:50px; width:35px; flex-shrink:0;" class="bg-secondary rounded d-flex align-items-center justify-content-center">
              <small class="text-white">📚</small>
            </div>
          <% end %>
          <div class="text-start overflow-hidden">
            <div class="fw-semibold text-truncate"><%= result[:title] %></div>
            <div class="text-muted small text-truncate"><%= result[:author] %></div>
          </div>
        </button>
      <% end %>
    </div>
  <% end %>
</turbo-frame>
