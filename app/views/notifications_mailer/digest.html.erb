<p style="margin-top: 0;">Hi <%= @user.display_name %>,</p>

<p>Here's what you missed on Community Bookshelf:</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin: 20px 0;">
  <% @notifications.each do |notification| %>
    <tr>
      <td style="padding: 10px 0; border-bottom: 1px solid #e9ecef;">
        <%= link_to notification.message, notification_url_for(notification), style: "text-decoration: none; color: #212529;" %>
      </td>
    </tr>
  <% end %>
</table>

<p style="text-align: center; margin: 32px 0;">
  <%= link_to "View all notifications", notifications_url,
        style: "display: inline-block; padding: 12px 28px; background-color: #0d6efd; color: #ffffff; " \
               "text-decoration: none; border-radius: 6px; font-weight: 600;" %>
</p>
