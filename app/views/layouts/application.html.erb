<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Community Bookshelf" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Community Bookshelf">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <script src="https://kit.fontawesome.com/b41e4928e6.js" crossorigin="anonymous"></script>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-0">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand fw-bold d-flex align-items-center" do %>
          <i class="fasl fa-books"></i>
          Community Bookshelf
        <% end %>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <%= link_to "Books", books_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Series", series_index_path, class: "nav-link" %>
            </li>
            <% if signed_in? %>
              <li class="nav-item">
                <%= link_to "Feed", feed_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "My Shelf", readings_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "My Lists", shelves_path, class: "nav-link" %>
              </li>
            <% end %>
            <% if current_user&.moderator_or_above? %>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                  <i class="fasl fa-gear me-1"></i>Admin
                </a>
                <ul class="dropdown-menu">
                  <% if current_user.admin? %>
                    <li>
                      <%= link_to admin_root_path, class: "dropdown-item" do %>
                        <i class="fasl fa-gauge me-2"></i>Dashboard
                      <% end %>
                    </li>
                    <li>
                      <%= link_to admin_users_path, class: "dropdown-item" do %>
                        <i class="fasl fa-users me-2"></i>Users
                      <% end %>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                  <% end %>
                  <li>
                    <%= link_to admin_readings_path, class: "dropdown-item" do %>
                      <i class="fasl fa-book-open me-2"></i>Reviewed Readings
                    <% end %>
                  </li>
                </ul>
              </li>
            <% end %>
          </ul>

          <ul class="navbar-nav">
            <% if signed_in? %>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                  <% if current_user.avatar.attached? %>
                    <%= image_tag current_user.avatar, style: "width: 24px; height: 24px; object-fit: cover; border-radius: 50%;", alt: "" %>
                  <% end %>
                  <%= current_user.display_name %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li>
                    <%= link_to user_path(current_user), class: "dropdown-item" do %>
                      <i class="fasl fa-circle-user me-2"></i>My Profile
                    <% end %>
                  </li>
                  <li>
                    <%= link_to edit_account_path, class: "dropdown-item" do %>
                      <i class="fasl fa-user-gear me-2"></i>My Account
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= button_to sign_out_path, method: :delete, class: "dropdown-item" do %>
                      <i class="fasl fa-arrow-right-from-bracket me-2"></i>Sign Out
                    <% end %>
                  </li>
                </ul>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to sign_in_path, class: "nav-link" do %>
                  <i class="fasl fa-arrow-right-to-bracket me-1"></i>Sign In
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to sign_up_path, class: "btn btn-primary btn-sm my-1 ms-2" do %>
                  <i class="fasl fa-user-plus me-1"></i>Sign Up
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <main class="app-main">
      <div class="container">
        <% if notice.present? %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fasl fa-circle-check me-2"></i><%= notice %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fasl fa-circle-exclamation me-2"></i><%= alert %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% end %>

        <%= yield %>
      </div>
    </main>

    <footer class="site-footer">
      <div class="container text-center">
        <i class="fasl fa-books"></i>
        <span class="site-footer-brand ms-2">Community Bookshelf</span>
        <div class="mt-1">A place for readers to share their shelves</div>
      </div>
    </footer>
  </body>
</html>
