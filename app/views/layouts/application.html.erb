<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Community Bookshelf" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Community Bookshelf">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "Community Bookshelf", root_path, class: "navbar-brand fw-bold" %>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <%= link_to "Books", books_path, class: "nav-link" %>
            </li>
            <% if signed_in? %>
              <li class="nav-item">
                <%= link_to "My Shelf", readings_path, class: "nav-link" %>
              </li>
            <% end %>
            <% if current_user&.admin? %>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Admin</a>
                <ul class="dropdown-menu">
                  <li><%= link_to "Dashboard", admin_root_path, class: "dropdown-item" %></li>
                  <li><%= link_to "Users", admin_users_path, class: "dropdown-item" %></li>
                </ul>
              </li>
            <% end %>
          </ul>

          <ul class="navbar-nav">
            <% if signed_in? %>
              <li class="nav-item">
                <span class="nav-link text-light opacity-75"><%= current_user.email %></span>
              </li>
              <li class="nav-item">
                <%= button_to "Sign Out", sign_out_path, method: :delete,
                      class: "btn btn-outline-light btn-sm my-1" %>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to "Sign In", sign_in_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Sign Up", sign_up_path, class: "btn btn-primary btn-sm my-1 ms-2" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container">
      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>
