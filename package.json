{
  "name": "app",
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@playwright/test": "^1.61.1",
    "esbuild": "^0.28.0"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:css:fonts": "sass ./app/assets/stylesheets/fonts.scss:./app/assets/builds/fonts.css --no-source-map --style=compressed",
    "build:css:compile": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --no-source-map --style=compressed --load-path=node_modules",
    "build:css:prefix": "postcss ./app/assets/builds/application.css --output=./app/assets/builds/application.css",
    "build:css": "yarn build:css:fonts && yarn build:css:compile && yarn build:css:prefix",
    "watch:css": "nodemon --watch ./app/assets/stylesheets/ --ext scss --exec \"yarn build:css\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.2.8",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@popperjs/core": "^2.11.8",
    "autoprefixer": "^10.5.0",
    "bootstrap": "^5.3.8",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1",
    "sass": "^1.100.0"
  },
  "browserslist": [
    "defaults"
  ]
}
